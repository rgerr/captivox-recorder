<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>LocalCaptureAgent</RootNamespace>
    <ApplicationIcon>Assets\captivox-recorder.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>CaptivoxRecorder</AssemblyName>
    <AssemblyTitle>Captivox Recorder</AssemblyTitle>
    <Product>Captivox Recorder</Product>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\captivox-banner.png" LogicalName="LocalCaptureAgent.Assets.captivox-banner.png" />
    <EmbeddedResource Include="Assets\captivox-logo.png" LogicalName="LocalCaptureAgent.Assets.captivox-logo.png" />
    <EmbeddedResource Include="Assets\captivox-recorder.ico" LogicalName="LocalCaptureAgent.Assets.captivox-recorder.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.29" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>

